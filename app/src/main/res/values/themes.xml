<?xml version="1.0" encoding="utf-8"?>
<!-- AppCompat parent: required by AppCompatActivity, which provides the
     per-app locale (AppCompatDelegate.setApplicationLocales). The app still
     renders dark-only via Compose; the window chrome stays dark regardless of
     the DayNight parent, and forceDark is disabled so the system never
     re-darkens what Compose draws. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HermesRemote" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#0B0D10</item>
        <item name="android:statusBarColor">#0B0D10</item>
        <item name="android:navigationBarColor">#0B0D10</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
